# ============================================================================
# SERVER CONFIGURATION (server-rust & docker-compose)
# ============================================================================
SERVER_BIND_ADDR=0.0.0.0:8080
DATABASE_URL=mysql://cmkmonitor:ChangeMeStrongDbPass!@mariadb:3306/cmk_enterprise
DB_MAX_CONNECTIONS=30

# MariaDB Container Credentials
MARIADB_ROOT_PASSWORD=ChangeMeRootPass!
MARIADB_DATABASE=cmk_enterprise
MARIADB_USER=cmkmonitor
MARIADB_PASSWORD=ChangeMeStrongDbPass!

# Authentication & Security (NEVER hardcode in source code)
JWT_SECRET=ChangeMe_UltraSecret_JWT_Key_Min_32_Bytes_2026!
HMAC_MASTER_PEPPER=ChangeMe_MasterPepper_For_Agent_Secrets_2026!
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMeAdmin2026!

# Optional: Bootstrap cabang pertama otomatis jika diisi.
# Kosongkan agar daftar cabang & host dimulai dalam keadaan kosong (input manual via Dashboard).
DEFAULT_BRANCH_CODE=
DEFAULT_BRANCH_NAME=
DEFAULT_ENROLLMENT_TOKEN=

# State Engine & Worker Intervals
BATCH_FLUSH_INTERVAL_SEC=180
STALE_CHECK_INTERVAL_SEC=30
HOST_STALE_THRESHOLD_SEC=180
LEGACY_PULL_ENABLED=true
LEGACY_PULL_INTERVAL_SEC=60
LEGACY_PULL_TIMEOUT_SEC=5
FLAPPING_THRESHOLD_CYCLES=2

# ============================================================================
# NOTIFICATION ROUTING (Telegram Group Topics, WhatsApp Webhook, & SMTP)
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

WA_WEBHOOK_URL=https://wa-gateway.internal/api/send
WA_WEBHOOK_TOKEN=

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=alert@company.co.id
SMTP_PASSWORD=
SMTP_FROM=Monitoring IT Ops <alert@company.co.id>

# ============================================================================
# AGENT CONFIGURATION (agent-rust)
# ============================================================================
AGENT_SERVER_URL=http://127.0.0.1:8080
AGENT_BRANCH_CODE=
AGENT_ENROLLMENT_TOKEN=
AGENT_SECRET_FILE=/var/lib/cmk-agent/agent.secret
AGENT_LOCAL_SCRIPTS_DIR=/usr/lib/check_mk_agent/local
AGENT_BRANCH_PROXY_ENABLED=false

# Self-Hosted Agent Binary Directory (mounted into container /app/downloads)
AGENT_DOWNLOAD_DIR=/app/downloads
GITHUB_RELEASES_URL=https://github.com/Dot-Dodik/cmkagent-rust/releases/latest
